# SPDX-License-Identifier: Apache-2.0
# Files added to the source distribution beyond the package itself.
include LICENSE NOTICE README.md CHANGELOG.md CITATION.cff
include ARCHITECTURE.md CONTRIBUTING.md CODE_OF_CONDUCT.md DEVELOPMENT.md
include RELEASE.md SECURITY.md SUPPORT.md VALIDATION.md VALIDATION_SPEC.md
include environment.yml .readthedocs.yaml .pre-commit-config.yaml
recursive-include cablexsec *.py *.yaml py.typed
recursive-include tests *.py
recursive-include tests/data *
recursive-include examples *.py *.json *.md
recursive-include validation *.md *.py *.csv *.json
recursive-include doc *.rst *.md *.py *.txt Makefile make.bat
recursive-include release *.py
global-exclude __pycache__ *.py[cod] *.nbi *.nbc
