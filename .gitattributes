# Enforce LF line endings for all text files on every platform so that
# ruff format --check (configured for "lf") does not falsely flag files
# checked out on Windows runners with core.autocrlf=true.
#
# Encoding policy: all tracked text (source, config, data and Markdown docs) is
# UTF-8. The docs use UTF-8 typographic and engineering glyphs (en dash,
# multiplication sign, Greek letters). They render correctly in any UTF-8
# terminal; on a legacy Windows console set the code page first with
# `chcp 65001` (or `$OutputEncoding = [Text.Encoding]::UTF8` in PowerShell).

* text=auto eol=lf

# Explicit text-with-LF for source / config / data types
*.py        text eol=lf
*.pyi       text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.rst       text eol=lf
*.cff       text eol=lf
*.txt       text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.csv       text eol=lf
*.json      text eol=lf
*.dat       text eol=lf
*.out       text eol=lf
*.asc       text eol=lf
LICENSE     text eol=lf
NOTICE      text eol=lf

# Binary and data formats. Marking Office files explicitly also prevents a
# machine-wide Git text-conversion driver from treating them as source.
*.pdf       binary
*.npy       binary
*.npz       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.docx      binary
*.xlsx      binary
*.xls       binary
*.zip       binary
*.sim       binary

# Genuine CableDyn output used as test data: keep the bytes (digests).
tests/data/cabledyn/** -text
